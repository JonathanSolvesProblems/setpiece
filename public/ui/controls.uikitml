<!--
  The panel is a blacked-out flag beside the set: stencil labels on the left,
  values on the right. Anything that can be pressed is a block with an edge;
  anything that only informs is plain chalk. Yellow means selected, red means
  recording, and an actor's line is written in that actor's tape colour.
  Fonts ship with the app (OFL, see fonts/OFL.txt).
-->
<style>
  @font-face { font-family: "Shoulders"; src: url("fonts/BigShoulders-Medium.ttf"); font-weight: 500; }
  @font-face { font-family: "Shoulders"; src: url("fonts/BigShoulders-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Stencil"; src: url("fonts/BigShouldersStencil-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "StencilBlack"; src: url("fonts/BigShouldersStencil-Black.ttf"); font-weight: 900; }
  @font-face { font-family: "Grotesk"; src: url("fonts/SchibstedGrotesk-Medium.ttf"); font-weight: 500; }
  @font-face { font-family: "Grotesk"; src: url("fonts/SchibstedGrotesk-SemiBold.ttf"); font-weight: 600; }

  .slate {
    flex-direction: column;
    width: 280px;
    background-color: #1b1411;
    border-radius: 3px;
    border-width: 2px;
    border-color: #5a4b3d;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    gap: 8px;
  }
  .title {
    font-family: "StencilBlack";
    font-weight: 900;
    font-size: 34px;
    line-height: 34px;
    color: #f6f7ef;
  }
  .rule { height: 2px; width: 100%; background-color: #5a4b3d; margin-top: 2px; margin-bottom: 2px; }
  .field { flex-direction: row; align-items: center; justify-content: space-between; gap: 10px; }
  .label {
    font-family: "Shoulders";
    font-weight: 700;
    font-size: 15px;
    line-height: 17px;
    color: #f6f7ef;
    width: 64px;
  }
  .status {
    font-family: "Grotesk";
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    color: #f6f7ef;
    flex-grow: 1;
    padding-left: 8px;
    border-left-width: 3px;
    border-color: #5a4b3d;
  }
  .lenses { flex-direction: row; gap: 2px; flex-grow: 1; justify-content: flex-start; }
  .takes { flex-direction: row; gap: 4px; flex-grow: 1; justify-content: flex-start; }
  .tabs { flex-direction: row; gap: 3px; width: 100%; justify-content: space-between; }
  .tab {
    text-align: center;
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 13px;
    line-height: 18px;
    color: #f6f7ef;
    flex-grow: 1;
    height: 36px;
    justify-content: center;
    align-items: center;
    border-radius: 2px;
    cursor: pointer;
  }
  .tab:hover { background-color: #5a4b3d; }
  .shelf {
    text-align: center;
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 13px;
    line-height: 16px;
    color: #f6f7ef;
    flex-grow: 1;
    padding-left: 4px;
    padding-right: 4px;
    height: 30px;
    border-bottom-width: 3px;
    border-color: #1b1411;
    justify-content: center;
    align-items: center;
    border-radius: 2px;
    cursor: pointer;
  }
  .shelf:hover { background-color: #5a4b3d; }
  .takebutton {
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 15px;
    line-height: 18px;
    color: #f6f7ef;
    background-color: #2a211c;
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 42px;
    height: 42px;
    text-align: center;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    border-color: #5a4b3d;
    border-radius: 2px;
    cursor: pointer;
  }
  .takebutton:hover { background-color: #5a4b3d; }
  .assetrow { flex-direction: row; gap: 6px; width: 100%; }
  .asset {
    text-align: center;
    font-family: "Grotesk";
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    color: #f6f7ef;
    background-color: #2a211c;
    width: 121px;
    height: 32px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    border-color: #5a4b3d;
    border-radius: 2px;
    cursor: pointer;
  }
  .asset:hover { background-color: #5a4b3d; }
  .keys { flex-direction: row; gap: 3px; width: 100%; }
  .key {
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 14px;
    line-height: 18px;
    color: #f6f7ef;
    text-align: center;
    width: 32px;
    height: 29px;
    justify-content: center;
    align-items: center;
    border-radius: 2px;
    cursor: pointer;
  }
  .key:hover { background-color: #5a4b3d; }
  .chips { flex-direction: row; gap: 4px; width: 100%; justify-content: space-between; }
  .chip {
    width: 27px;
    height: 27px;
    border-width: 2px;
    border-color: #1b1411;
    border-radius: 2px;
    cursor: pointer;
  }
  .page { flex-direction: column; gap: 8px; width: 100%; }
  .short { width: 38px; }
  .wide { width: 100%; }
  .strong { font-weight: 600; font-size: 15px; }
  .lens {
    font-family: "Shoulders";
    font-weight: 700;
    font-size: 17px;
    line-height: 20px;
    color: #f6f7ef;
    width: 32px;
    height: 34px;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-radius: 2px;
    cursor: pointer;
  }
  .lens:hover { background-color: #5a4b3d; }
  .word {
    text-align: center;
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 14px;
    line-height: 18px;
    color: #f6f7ef;
    background-color: #2a211c;
    height: 34px;
    justify-content: center;
    align-items: center;
    padding-left: 9px;
    padding-right: 9px;
    border-width: 2px;
    border-color: #5a4b3d;
    border-radius: 2px;
    cursor: pointer;
  }
  .word:hover { background-color: #5a4b3d; }
  .primary {
    font-family: "Grotesk";
    font-weight: 600;
    font-size: 17px;
    line-height: 22px;
    color: #1b1411;
    background-color: #f6f7ef;
    height: 46px;
    justify-content: center;
    align-items: center;
    border-radius: 2px;
    text-align: center;
    cursor: pointer;
  }
  .line {
    font-family: "Grotesk";
    font-weight: 500;
    font-size: 13px;
    line-height: 17px;
    color: #f6f7ef;
  }
  .muted { color: #c7c7b7; }
</style>
<div id="panel-root" class="slate">
  <div class="field">
    <div id="panel-title" class="title">SETPIECE</div>
    <div id="btn-voice" class="word" style="display: none">Say a scene</div>
  </div>
  <div id="voice-line" class="line muted" style="display: none"> </div>
  <div class="field">
    <div class="label short">STAGE</div>
    <div id="stage-status" class="status">Floating. Not on your table yet.</div>
  </div>
  <div id="btn-snap" class="primary">Snap frame</div>
  <div id="btn-back" class="primary" style="display: none">Back to the table</div>
  <div class="tabs">
    <div id="tab-shoot" class="tab">Shoot</div>
    <div id="tab-camera" class="tab">Camera</div>
    <div id="tab-assets" class="tab">Assets</div>
    <div id="tab-briefs" class="tab">Briefs</div>
    <div id="tab-stage" class="tab">Stage</div>
  </div>
  <div id="page-shoot" class="page">
    <div class="field">
      <div class="label short">LENS</div>
      <div class="lenses">
        <div id="lens-18" class="lens">18</div>
        <div id="lens-24" class="lens">24</div>
        <div id="lens-35" class="lens">35</div>
        <div id="lens-50" class="lens">50</div>
        <div id="lens-85" class="lens">85</div>
        <div id="lens-135" class="lens">135</div>
      </div>
    </div>
    <div class="field">
      <div class="label short">TAKE</div>
      <div class="takes">
        <div id="btn-record" class="takebutton">Record</div>
        <div id="btn-play" class="takebutton" style="display: none">Play</div>
      </div>
    </div>
    <div class="field">
      <div class="label short">CAM</div>
      <div class="takes">
        <div id="btn-cam-a" class="word">Cam A</div>
        <div id="btn-cam-b" class="word">Add cam B</div>
      </div>
    </div>
    <div class="field">
      <div class="label short">EYES</div>
      <div id="eyeline-a" class="line">A: place the creature and an actor</div>
    </div>
    <div class="field">
      <div class="label short"> </div>
      <div id="eyeline-b" class="line"> </div>
    </div>
    <div class="field">
      <div id="board-count" class="line muted">No frames yet</div>
      <div id="btn-new-board" class="word">New board</div>
    </div>
  </div>
  <div id="page-camera" class="page" style="display: none">
    <div class="field">
      <div class="label">FORMAT</div>
      <div id="btn-format" class="word">Full frame</div>
    </div>
    <div class="field">
      <div class="label">RIG</div>
      <div id="btn-rig" class="word">Tripod</div>
    </div>
    <div id="strike-row" class="field" style="display: none">
      <div class="line muted">Second camera</div>
      <div id="btn-strike-b" class="word">Strike cam B</div>
    </div>
    <div class="line muted">Same lens, smaller format: a tighter picture. On the drone, carry the camera as high as you can reach, up to 11 m on the real set.</div>
  </div>
  <div id="page-assets" class="page" style="display: none">
    <div class="tabs">
      <div id="shelf-Cast" class="shelf">Cast</div>
      <div id="shelf-Creatures" class="shelf">Creatures</div>
      <div id="shelf-Vehicles" class="shelf">Vehicles</div>
      <div id="shelf-Effects" class="shelf">Effects</div>
    </div>
    <div class="tabs">
      <div id="shelf-Set" class="shelf">Set</div>
      <div id="shelf-Props" class="shelf">Props</div>
      <div id="shelf-Scenes" class="shelf">Scenes</div>
      <div id="shelf-Search" class="shelf">Search</div>
    </div>
    <div id="search-box" class="page" style="display: none">
      <div id="search-query" class="status">Spell a name</div>
      <div class="keys"><div id="key-a" class="key">A</div><div id="key-b" class="key">B</div><div id="key-c" class="key">C</div><div id="key-d" class="key">D</div><div id="key-e" class="key">E</div><div id="key-f" class="key">F</div><div id="key-g" class="key">G</div></div>
      <div class="keys"><div id="key-h" class="key">H</div><div id="key-i" class="key">I</div><div id="key-j" class="key">J</div><div id="key-k" class="key">K</div><div id="key-l" class="key">L</div><div id="key-m" class="key">M</div><div id="key-n" class="key">N</div></div>
      <div class="keys"><div id="key-o" class="key">O</div><div id="key-p" class="key">P</div><div id="key-q" class="key">Q</div><div id="key-r" class="key">R</div><div id="key-s" class="key">S</div><div id="key-t" class="key">T</div><div id="key-u" class="key">U</div></div>
      <div class="keys"><div id="key-v" class="key">V</div><div id="key-w" class="key">W</div><div id="key-x" class="key">X</div><div id="key-y" class="key">Y</div><div id="key-z" class="key">Z</div><div id="key-del" class="key">Del</div></div>
    </div>
    <div class="assetrow">
      <div id="asset-0" class="asset">-</div>
      <div id="asset-1" class="asset">-</div>
    </div>
    <div class="assetrow">
      <div id="asset-2" class="asset">-</div>
      <div id="asset-3" class="asset">-</div>
    </div>
    <div class="assetrow">
      <div id="asset-4" class="asset">-</div>
      <div id="asset-5" class="asset">-</div>
    </div>
    <div class="assetrow">
      <div id="asset-6" class="asset">-</div>
      <div id="asset-7" class="asset">-</div>
    </div>
    <div id="shelf-pager" class="field" style="display: none">
      <div id="shelf-page" class="line muted">1 of 2</div>
      <div id="btn-more" class="word">More</div>
    </div>
    <div id="fx-note" class="line muted" style="display: none">Effects are stand-ins, not simulations.</div>
    <div id="held-block" class="page">
    <div class="rule"></div>
    <div class="field">
      <div class="label short">HELD</div>
      <div id="cast-line" class="line">Pick up a piece to change it</div>
    </div>
    <div id="paint-row" class="chips" style="display: none">
      <div id="paint-0" class="chip" style="background-color: #c4a07a"></div>
      <div id="paint-1" class="chip" style="background-color: #9c3a2e"></div>
      <div id="paint-2" class="chip" style="background-color: #b86f33"></div>
      <div id="paint-3" class="chip" style="background-color: #c4a23f"></div>
      <div id="paint-4" class="chip" style="background-color: #4c6e52"></div>
      <div id="paint-5" class="chip" style="background-color: #3d5b7c"></div>
      <div id="paint-6" class="chip" style="background-color: #d8d3c4"></div>
      <div id="paint-7" class="chip" style="background-color: #2a2826"></div>
    </div>
    <div id="held-row" class="takes" style="display: none">
      <div id="btn-size" class="word">Size</div>
      <div id="btn-style" class="word" style="display: none">Fit</div>
      <div id="btn-copy" class="word" style="display: none">Copy</div>
      <div id="btn-pose" class="word" style="display: none">Pose</div>
      <div id="btn-look" class="word" style="display: none">Look</div>
      <div id="btn-remove" class="word">Remove</div>
    </div>
    </div>
    <div class="field">
      <div id="assets-count" class="line muted">3 on the set</div>
      <div id="btn-clear-set" class="word">Clear set</div>
    </div>
  </div>
  <div id="page-briefs" class="page" style="display: none">
    <div id="brief-count" class="label wide">SHOT 1 OF 9</div>
    <div id="brief-title" class="line strong">Wide establishing shot</div>
    <div id="brief-ask" class="line">Everyone and the creature in frame.</div>
    <div class="line muted">Frame it and press Snap. A frame that meets the brief is stamped PRINT.</div>
    <div class="field">
      <div class="label"> </div>
      <div id="btn-skip-brief" class="word">Next shot</div>
    </div>
  </div>
  <div id="page-stage" class="page" style="display: none">
    <div class="field">
      <div class="label short">TABLE</div>
      <div class="takes">
        <div id="btn-reset-stage" class="word">Reset stage</div>
        <div id="btn-find-table" class="word" style="display: none">Find my table</div>
      </div>
    </div>
    <div id="btn-life" class="takebutton">Stand in the shot</div>
    <div class="line muted">The set at full size around you, seen from the camera. It takes two presses.</div>
    <div class="field">
      <div class="label short">ACTORS</div>
      <div id="btn-squirm" class="word">Squirm when held: on</div>
    </div>
    <div class="field">
      <div class="label short">LEAVE</div>
      <div id="exit-button" class="word">Exit to browser</div>
    </div>
  </div>
  <div id="xr-button" class="primary" style="display: none">Enter XR</div>
</div>
