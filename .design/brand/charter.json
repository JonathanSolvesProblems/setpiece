  "title_punctuation": "forbid",
  "max_tracked_caps_rules": 2,
  "allow_long_dashes": false,
  "forbid_regex": [
    {
      "pattern": "class=\"[^\"]*eyebrow",
      "why": "no eyebrow labels above titles (law 4)"
    },
    {
      "pattern": "border-radius:\\s*(1[2-9]|[2-9]\\d)px",
      "why": "slate edges are square or barely eased (law 9)"
    },
    {
      "pattern": "box-shadow:[^;]*rgba?\\([^)]*,\\s*0?\\.[5-9]",
      "why": "no heavy shadow; the slate is matte (law 10)"
    },
    {
      "pattern": "\\b(Lucide|lucide-react|feather-icons|heroicons|phosphor)\\b",
      "why": "icons are drawn in the chalk hand (kit)"
    }
  ]
}